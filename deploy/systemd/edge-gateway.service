[Unit]
Description=Industrie 4.0 edge gateway (MQTT -> OPC UA)
Documentation=https://github.com/PawanShetty-9/industrie40-telemetry-gateway
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=edgegw
Group=edgegw
WorkingDirectory=/opt/industrie40-telemetry-gateway
# /var/lib/industrie40-edge-gateway is created by systemd (StateDirectory) and
# holds the OPC UA server certificate. --secure-only: encrypted endpoints only.
ExecStart=/opt/industrie40-telemetry-gateway/.venv/bin/python edge_gateway.py \
    --mqtt-host localhost \
    --opcua-endpoint opc.tcp://localhost:4840 \
    --pki-dir /var/lib/industrie40-edge-gateway/pki \
    --secure-only
StateDirectory=industrie40-edge-gateway
StateDirectoryMode=0700
UMask=0077
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# The gateway exits non-zero on fatal errors; systemd restarts it.
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Hardening: the service can only write its state directory and use the network.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
